# Copiez ce fichier en .env et changez au minimum JWT_SECRET avant la mise en ligne.

PORT=3000

# ---------------------------------------------------------------
# Base de données PostgreSQL (obligatoire)
# ---------------------------------------------------------------
# Local (Docker) : postgres://okimart:okimart@localhost:5432/okimart
# Render         : copiez l'"Internal Database URL" (ou "External" en dehors
#                  de Render) depuis le tableau de bord de votre instance
#                  Render PostgreSQL, onglet "Connect".
DATABASE_URL=

# Mettez "false" uniquement pour une base Postgres locale sans TLS (Docker).
# Laissez vide/absent en production (Render exige TLS).
PGSSL=

# Obligatoire en production : chaîne aléatoire longue et secrète (sert à signer
# les sessions admin ET client). Générez-en une avec : openssl rand -hex 32
JWT_SECRET=change-this-secret-in-production

# Optionnel : si non défini, un mot de passe aléatoire est généré au premier
# démarrage et affiché une seule fois (voir ADMIN-IDENTIFIANTS.txt).
FIRST_ADMIN_EMAIL=admin@okimart.studio
FIRST_ADMIN_PASSWORD=

# Mettez "production" une fois en ligne avec HTTPS (rend les cookies "secure").
NODE_ENV=development

# ---------------------------------------------------------------
# Cloudinary — stockage de TOUTES les images, vidéos et fichiers privés
# de la plateforme (photos, produits, logiciels...). Plus rien n'est
# persisté sur le disque du serveur — indispensable sur Render (disque
# non persistant, y compris sur le plan payant sans disque additionnel).
# Récupérez ces 3 valeurs sur le tableau de bord Cloudinary (Dashboard).
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier Cloudinary pour les vidéos envoyées en Direct Upload depuis
# l'admin (portfolio) — créé automatiquement, rien à faire.
CLOUDINARY_VIDEO_FOLDER=okimart/videos
